import os
usub_lib_dir = os.path.abspath(os.path.join(os.getcwd(), '..', 'build'))
# Initial geometry is read from Abaqus-generated ASCII FIL output.
os.environ.pop('CDPM2_GEOMETRY_TABLE', None)
os.environ.pop('CDPM2_FIL_FILE', None)
os.environ['CDPM2_VISCO_LOG_PATH'] = os.path.join(os.getcwd(), 'trials.txt')
os.environ['CDPM2_VISCO_LOG_LIMIT'] = '64'
os.environ['CDPM2_VISCO_LOG_MODE'] = 'ALL'
